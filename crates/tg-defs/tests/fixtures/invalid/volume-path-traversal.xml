<?xml version="1.0" encoding="UTF-8"?>
<!--
  xs:pattern on MountPath: '..' is no part of a name. A mount point that points
  out of the container is the most dangerous form of a typo.
-->
<workloads xmlns="urn:tardigrade:workload:v1">
  <workload name="ledger" kind="service">
    <image reference="registry.example.com/ledger:2.1"/>
    <volumes>
      <volume name="data" path="/var/../../etc" mode="readWrite" size="8388608"/>
    </volumes>
  </workload>
</workloads>
