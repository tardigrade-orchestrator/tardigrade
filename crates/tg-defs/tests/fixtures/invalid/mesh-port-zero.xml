<?xml version="1.0" encoding="UTF-8"?>
<!--
  Port 0 means "pick one yourself" in the kernel. As a setting in a definition
  that is no setting, and the facet refuses it.
-->
<workloads xmlns="urn:tardigrade:workload:v1">
  <workload name="api" kind="service">
    <image reference="registry.example.com/api:1.0"/>
    <mesh port="0"/>
  </workload>
</workloads>
